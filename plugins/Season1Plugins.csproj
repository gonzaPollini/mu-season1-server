<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugins propios para OpenMU, compilados contra los ensamblados de la imagen en la que corren. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Season1.OpenMU.Plugins</AssemblyName>
    <RootNamespace>Season1.OpenMU</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenMuDir Condition="'$(OpenMuDir)' == ''">/openmu</OpenMuDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(OpenMuDir)/MUnique.OpenMU.*.dll" Private="false" />
    <Reference Include="$(OpenMuDir)/Nito.*.dll" Private="false" />
    <Using Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>
</Project>
